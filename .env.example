# Customer service API -> mock business API
APP_BUSINESS_BASE_URL=http://127.0.0.1:8010
APP_BUSINESS_INTERNAL_TOKEN=dev-internal-token
APP_BUSINESS_TIMEOUT_SECONDS=3

# Mock business API authentication
MOCK_BUSINESS_INTERNAL_TOKEN=dev-internal-token

# Model Gateway. Fake mode runs locally without external credentials.
MODEL_PROVIDER=fake
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_TEMPERATURE=0.2
MODEL_MAX_OUTPUT_TOKENS=600

# Required only when MODEL_PROVIDER=openai.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
