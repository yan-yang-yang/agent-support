# Customer service API -> mock business API
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80
# Optional image mirrors for environments that cannot access Docker Hub.
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
APP_DEFAULT_USER_ID=demo-user
APP_STREAM_CHARACTER_DELAY=0.018
APP_BUSINESS_BASE_URL=http://127.0.0.1:8010
APP_BUSINESS_INTERNAL_TOKEN=dev-internal-token
APP_BUSINESS_TIMEOUT_SECONDS=3

# Mock business API authentication
MOCK_BUSINESS_INTERNAL_TOKEN=dev-internal-token

# Model Gateway. Fake mode runs locally without external credentials.
MODEL_PROVIDER=fake
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_TEMPERATURE=0.2
MODEL_MAX_OUTPUT_TOKENS=600
AGENT_MAX_TOOL_CALLS=6
MEMORY_RECENT_MESSAGE_LIMIT=6
MEMORY_SUMMARY_MAX_CHARS=1600
MEMORY_MAX_LONG_TERM_ITEMS=12

# Required only when MODEL_PROVIDER=openai.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
